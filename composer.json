            "name": "Viktor Szépe",
            "email": "viktor@szepe.net"
        }
    ],
    "require-dev": {
        "php-stubs/acf-pro-stubs": "^6.3",
        "szepeviktor/phpcs-psr-12-neutron-hybrid-ruleset": "^0.11.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
